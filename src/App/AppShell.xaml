<?xml version="1.0" encoding="UTF-8" ?>
<!-- The side menu mirrors the website's drawer (WebApp.Client/Components/Layout/NavBar.razor): the brand name on
     top, icon-and-label items, the language menu and the copyright at the bottom, all on the primary color.
     FlyoutBackgroundColor is set here rather than in Styles.xaml: Shell's constructor binds it to a white or black
     theme binding, which outranks any style setter (dotnet/maui#9736). -->
<Shell x:Class="Ingweland.Fog.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Ingweland.Fog.App.Views"
       xmlns:loc="clr-namespace:Ingweland.Fog.Application.Client.Core.Localization;assembly=Ingweland.Fog.Application.Client.Core"
       FlyoutBehavior="Flyout"
       FlyoutHeaderBehavior="Fixed"
       FlyoutBackgroundColor="{StaticResource Primary}">

    <Shell.FlyoutHeader>
        <!-- A layout rather than a bare Label, so the header keeps clear of the status bar and the notch. -->
        <Grid Padding="0,12">
            <Label Text="{x:Static loc:FogResource.BrandName}" Style="{StaticResource FogMenuHeaderLabel}" />
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="16,12">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource FogMenuSelectedColor}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Image Source="{Binding FlyoutIcon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource FogMenuItemLabel}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="12,12,12,8" Spacing="8">
            <!-- The website's language menu (LanguageSelectorComponent), white like its text. menu_translate.svg is
                 Google's translate_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24.svg and menu_arrow_down.svg is the
                 website's MudBlazor Icons.Material.Filled.KeyboardArrowDown. -->
            <HorizontalStackLayout HorizontalOptions="Center" Padding="4,6" Spacing="8">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLanguageTapped" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="menu_translate.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Label x:Name="LanguageLabel" Style="{StaticResource FogMenuItemLabel}" />
                <Image Source="menu_arrow_down.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="2">
                <Label x:Name="CopyrightLabel" Style="{StaticResource FogMenuFooterLabel}" />
                <Label Text="{x:Static loc:FogResource.Common_AllRightsReserved}"
                       Style="{StaticResource FogMenuFooterLabel}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- The website's menu icons (WebApp.Client/Services/MainMenuService.cs), downloaded from the CDN's images/icons:
         menu_city.svg is the city guides' strategy_24dp_FBE0C6_FILL0_wght400_GRAD0_opsz24.svg and menu_about.svg is
         About's info_24dp_FBE0C6_FILL0_wght400_GRAD0_opsz24.svg. -->
    <FlyoutItem Title="{x:Static loc:FogResource.CityViewer_Title}" Icon="menu_city.png">
        <ShellContent ContentTemplate="{DataTemplate views:CityViewerHomePage}" Route="CityViewerHome" />
    </FlyoutItem>

    <FlyoutItem Title="{x:Static loc:FogResource.Navigation_About}" Icon="menu_about.png">
        <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" Route="About" />
    </FlyoutItem>

</Shell>
