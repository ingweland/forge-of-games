<?xml version="1.0" encoding="utf-8" ?>
<!-- BuildingInfoItemComponent: a larger icon above its value. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Ingweland.Fog.Application.Client.Web.ViewModels.Hoh;assembly=Ingweland.Fog.Application.Client.Web"
             x:Class="Ingweland.Fog.App.Views.CityViewer.IconLabelTile"
             x:DataType="vm:IconLabelItemViewModel">
    <Border Style="{StaticResource FogTile}">
        <VerticalStackLayout Spacing="4">
            <Image Source="{Binding IconUrl}" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Label}" Style="{StaticResource FogTileLabel}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
