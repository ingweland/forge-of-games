<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Ingweland.Fog.App.Views.CityViewer"
             x:Class="Ingweland.Fog.App.Views.CityViewerPage"
             BackgroundColor="{StaticResource FogMapBackgroundColor}"
             Shell.FlyoutBehavior="Disabled">

    <!-- No side menu on the map: its edge swipe would compete with panning. The back button stays. -->
    <ContentPage.Resources>
        <Style x:Key="MapToolButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BackgroundColor" Value="#99000000" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- The map, its side panel and its bottom sheet; a guide's layout timeline item hosts the same view. -->
        <cv:CityMapView x:Name="Map" BackgroundColor="{StaticResource FogMapBackgroundColor}" />

        <!-- Over the map, and so hidden while the panel is covering it (see UpdateToolbar). -->
        <VerticalStackLayout x:Name="Toolbar"
                             IsVisible="False"
                             HorizontalOptions="End"
                             VerticalOptions="Start"
                             Margin="12"
                             Spacing="8">
            <ImageButton Source="zoom_in.png" Style="{StaticResource MapToolButton}" Clicked="OnZoomInClicked" />
            <ImageButton Source="zoom_out.png" Style="{StaticResource MapToolButton}" Clicked="OnZoomOutClicked" />
            <ImageButton Source="fit_screen.png" Style="{StaticResource MapToolButton}"
                         Clicked="OnFitToScreenClicked" />
            <ImageButton x:Name="AnalyticsButton" Source="analytics.png" IsVisible="False"
                         Style="{StaticResource MapToolButton}" Clicked="OnAnalyticsClicked" />
        </VerticalStackLayout>

        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="True"
                           Color="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <Label x:Name="ErrorLabel"
               IsVisible="False"
               TextColor="White"
               Margin="24"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
