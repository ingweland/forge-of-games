<?xml version="1.0" encoding="utf-8" ?>
<!-- AlliedCultureCalendarItemCard.razor: the culture's icon in the corner, the wonder's name and the dates. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Ingweland.Fog.App.Views.CityViewer"
             xmlns:models="clr-namespace:Ingweland.Fog.App.ViewModels.Guides"
             x:Class="Ingweland.Fog.App.Views.Guides.CalendarCard"
             x:DataType="models:CalendarCardModel">
    <Border Style="{StaticResource FogCalendarCard}">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.1" Radius="4" Offset="0,2" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid MinimumHeightRequest="80">
            <cv:AssetImage Url="{Binding Item.IconUrl}" WidthRequest="20" HeightRequest="20" Aspect="AspectFit"
                           Margin="2" HorizontalOptions="Start" VerticalOptions="Start" />
            <VerticalStackLayout Padding="22,8" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding Item.Name}" Style="{StaticResource FogTextLabel}" FontSize="16"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding Item.DatesFormatted}" Style="{StaticResource FogTextLabel}" FontSize="12"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
