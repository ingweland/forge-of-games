<?xml version="1.0" encoding="UTF-8" ?>
<!-- The website's look (src/WebApp/wwwroot/app.css) for the city planner panels and the side menu. The colours
     are in Colors.xaml. A keyed style replaces the implicit one, so each style sets its own font and colours. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cv="clr-namespace:Ingweland.Fog.App.Views.CityViewer"
    xmlns:vm="clr-namespace:Ingweland.Fog.Application.Client.Web.ViewModels.Hoh;assembly=Ingweland.Fog.Application.Client.Web">

    <!-- The width of the website's 1px borders and rules. App sets it to whole device pixels for the window's
         display scale; 1 is only the value before the window reports it. -->
    <x:Double x:Key="FogHairlineThickness">1</x:Double>

    <!-- Text -->
    <Style x:Key="FogTextLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource FogTextColor}" />
    </Style>

    <Style x:Key="FogBoldTextLabel" TargetType="Label" BasedOn="{StaticResource FogTextLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="FogSmallTextLabel" TargetType="Label" BasedOn="{StaticResource FogTextLabel}">
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="FogSmallBoldTextLabel" TargetType="Label" BasedOn="{StaticResource FogBoldTextLabel}">
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- Card (.fog-container) -->
    <Style x:Key="FogCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogSurfaceColor}" />
        <Setter Property="Stroke" Value="{StaticResource FogBorderColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FogHairlineThickness}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Age tag in a card's top-left corner; the background is the age color. -->
    <Style x:Key="FogAgeTag" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 7,0,0,8" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinimumWidthRequest" Value="80" />
        <Setter Property="MinimumHeightRequest" Value="22" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="FogAgeTagLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Section header tag (StatsSectionHeader) -->
    <Style x:Key="FogSectionTag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogContainerColor}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="FogSectionTagLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource FogTextOnContainerColor}" />
    </Style>

    <!-- Chip (GeneralProductionItemComponent) and tile (BuildingInfoItemComponent) -->
    <Style x:Key="FogChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogSurfaceColor}" />
        <Setter Property="Stroke" Value="{StaticResource FogContainerColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FogHairlineThickness}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="FogTile" TargetType="Border" BasedOn="{StaticResource FogChip}">
        <Setter Property="Padding" Value="6,6,6,2" />
    </Style>

    <Style x:Key="FogChipLabel" TargetType="Label" BasedOn="{StaticResource FogSmallBoldTextLabel}">
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogTileLabel" TargetType="Label" BasedOn="{StaticResource FogBoldTextLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Tables (StatsTable) -->
    <Style x:Key="FogTableHeaderLabel" TargetType="Label" BasedOn="{StaticResource FogSmallBoldTextLabel}">
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogTableCellLabel" TargetType="Label" BasedOn="{StaticResource FogSmallTextLabel}">
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogProductCellLabel" TargetType="Label" BasedOn="{StaticResource FogTableCellLabel}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- The viewer is read-only, so this button only ever shows its disabled look. On Windows the button's
         own colors are also used when it is disabled, so the grey has to be set here. -->
    <Style x:Key="FogDisabledButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource FogDisabledBackgroundColor}" />
        <Setter Property="TextColor" Value="{StaticResource FogDisabledTextColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Side menu (the website's drawer, NavBar.razor) -->
    <Style x:Key="FogMenuHeaderLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogMenuItemLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogMenuFooterLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Allied culture city guides (AlliedCultureCityGuides.razor) -->
    <Style x:Key="FogSectionTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource FogTextOnContainerColor}" />
        <Setter Property="Padding" Value="6,8,50,2" />
    </Style>

    <Style x:Key="FogCityNameLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource FogTextOnBackgroundColor}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,14,0,0" />
    </Style>

    <!-- AlliedCultureCityGuideItem.razor: the image fills the card, the name sits over its bottom edge. -->
    <Style x:Key="FogGuideCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="120" />
    </Style>

    <Style x:Key="FogGuideCardLabel" TargetType="Label" BasedOn="{StaticResource FogTextLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BackgroundColor" Value="{StaticResource FogSurfaceColor}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,-6,0,0" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- AlliedCultureCalendarItemCard.razor, the website's .command-center-card. -->
    <Style x:Key="FogCalendarCard" TargetType="Border" BasedOn="{StaticResource FogCard}">
        <Setter Property="MinimumHeightRequest" Value="80" />
    </Style>

    <!-- City guide viewer (CityStrategyMobileViewerComponent.razor.css,
         CityStrategyTimelineViewerComponent.razor.css) -->
    <Style x:Key="FogToolbarButton" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- The .name-container tag hanging under the timeline panel's top edge. -->
    <Style x:Key="FogTimelineHeader" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogContainerColor}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 0,0,8,8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="12,0" />
    </Style>

    <Style x:Key="FogTimelineHeaderLabel" TargetType="Label" BasedOn="{StaticResource FogBoldTextLabel}">
        <Setter Property="TextColor" Value="{StaticResource FogTextOnContainerColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- .list-index: the item's number in a circle. -->
    <Style x:Key="FogTimelineIndex" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogContainerColor}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="FogTimelineIndexLabel" TargetType="Label" BasedOn="{StaticResource FogSmallTextLabel}">
        <Setter Property="TextColor" Value="{StaticResource FogTextOnContainerColor}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FogTimelineItemLabel" TargetType="Label" BasedOn="{StaticResource FogTextLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- .timeline-item-title-container: which item the content area is showing. -->
    <Style x:Key="FogTimelineItemTitleLabel" TargetType="Label" BasedOn="{StaticResource FogBoldTextLabel}">
        <Setter Property="TextColor" Value="{StaticResource FogTextOnContainerColor}" />
        <Setter Property="Padding" Value="6,0,6,6" />
    </Style>

    <!-- Markdown (.markdown-city-guide) -->
    <!-- The .component-root of the Description and Intro items: a white card with a square hairline border,
         holding the MarkdownView that draws the guide's text. -->
    <Style x:Key="FogGuideContent" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogSurfaceColor}" />
        <Setter Property="Stroke" Value="{StaticResource FogBorderColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FogHairlineThickness}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Fenced and indented code. No monospace family: neither bundled font has one and the names the
         platforms do ship differ, so the tinted block is what marks it. -->
    <Style x:Key="FogCodeBlock" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FogZebraColor}" />
        <Setter Property="Stroke" Value="{StaticResource FogBorderColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FogHairlineThickness}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Item templates for WrapList -->
    <DataTemplate x:Key="FogChipTemplate" x:DataType="vm:IconLabelItemViewModel">
        <cv:IconLabelChip />
    </DataTemplate>

    <DataTemplate x:Key="FogTileTemplate" x:DataType="vm:IconLabelItemViewModel">
        <cv:IconLabelTile />
    </DataTemplate>
</ResourceDictionary>
