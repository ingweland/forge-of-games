@attribute [Route(FogUrlBuilder.PageRoutes.HELP_ITHACA_PREMIUM_GUIDE_PATH)]
@using Ingweland.Fog.Application.Core.Helpers
@inherits Ingweland.Fog.WebApp.Client.Components.Pages.Abstractions.FogPageBase

<div class="help-container">
    <h3>Ithaca Premium Guide</h3>

    <div class="help-info">
        The <strong>Ithaca Premium Guide</strong> is an in-depth guide to the Ithaca
        (Penelope&rsquo;s Hearth) Allied Culture city, written and maintained by <strong>Dagorad</strong>.
        It is his own work and he distributes it himself &mdash; it is not hosted on, or sold through,
        Forge of Games. This page simply explains how to get hold of it.
    </div>

    <div class="help-step">
        <h5>Two ways to get it</h5>
        <ul>
            <li>
                <strong>Buy it directly from Dagorad.</strong> Get in touch with him on Discord and
                he&rsquo;ll walk you through the details.
            </li>
            <li>
                <strong>Free for existing supporters.</strong> If you had already donated to Forge of Games
                by the time this was announced, the guide is yours free of charge. This is our token of gratitude to
                those who voluntarily decided to support the website. Please note that donations cannot and will not
                guarantee any exclusive bonuses in the future. This is not a hidden purchase system; it exists for
                people who value our work and are willing to support it financially.
                There is nothing you need to do: the guide will be sent to the email address you used when donating
                before the event starts.
            </li>
        </ul>
        <p>
            <strong>Supporters:</strong> if the guide hasn&rsquo;t reached you, please check your spam or junk
            folder first &mdash; that&rsquo;s where it usually hides. If it&rsquo;s in neither your inbox nor
            your spam folder, get in touch with Dagorad using the steps below and he&rsquo;ll sort it out.
        </p>
    </div>

    <div class="help-step">
        <h5>How to reach Dagorad</h5>
        <p>
            Follow these steps if you want to buy the guide, or if you&rsquo;re a supporter whose copy
            never arrived.
        </p>
        <ol>
            <li>
                Join our <a href="@FogUrlBuilder.PageRoutes.FOG_DISCORD_URL" target="_blank">Discord server</a>
                &mdash; skip this step if you&rsquo;re already a member.
            </li>
            <li>
                Open the pinned <strong>&ldquo;Ithaca Premium Guide&rdquo;</strong> thread in
                <em>Discussions</em>, or jump straight to it using
                <a href="@FogUrlBuilder.PageRoutes.FOG_DISCORD_ITHACA_PREMIUM_GUIDE_THREAD_URL" target="_blank">
                    this link</a>.
            </li>
            <li>
                Dagorad is the author of that thread &mdash; the topic starter.
            </li>
            <li>
                Read the instructions posted there, then send Dagorad a direct message to arrange
                getting the guide.
            </li>
        </ol>
    </div>
</div>
